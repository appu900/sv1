{
  "name": "main-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:admin": "ts-node -r tsconfig-paths/register src/seeds/admin.seed.ts",
    "seed:demo-user": "ts-node -r tsconfig-paths/register src/seeds/demo-user.seed.ts",
    "seed:ingredient-seasonality": "ts-node -r tsconfig-paths/register scripts/generate-ingredient-seasonality.ts",
    "check:subscription-periods": "ts-node -r tsconfig-paths/register scripts/check-subscription-periods.ts",
    "backfill:cooked-recipes-objectids": "ts-node -r tsconfig-paths/register scripts/backfill-cooked-recipes-objectids.ts",
    "backfill:legacy-insights": "ts-node -r tsconfig-paths/register scripts/backfill-legacy-insights.ts",
    "backfill:chef-profiles": "ts-node -r tsconfig-paths/register scripts/backfill-chef-profiles.ts",
    "backfill:hero-image-variants": "ts-node -r tsconfig-paths/register scripts/backfill-hero-image-variants.ts",
    "measure:summary-payloads": "ts-node -r tsconfig-paths/register scripts/measure-summary-payloads.ts",
    "measure:image-variants": "ts-node -r tsconfig-paths/register scripts/measure-image-variants.ts",
    "backfill:food-saved-chef-ids": "ts-node -r tsconfig-paths/register scripts/backfill-food-saved-chef-ids.ts",
    "migrate:s3-image-urls": "ts-node -r tsconfig-paths/register scripts/migrate-s3-image-urls-to-cdn.ts",
    "rebuild:chef-impact-rollups": "ts-node -r tsconfig-paths/register scripts/rebuild-chef-impact-rollups.ts",
    "sync:unsubscribed-users": "ts-node -r tsconfig-paths/register scripts/sync-unsubscribed-users.ts",
    "grant:legend-access": "ts-node -r tsconfig-paths/register scripts/grant-legend-access.ts",
    "export:ingredients": "ts-node -r tsconfig-paths/register scripts/export-ingredients.ts",
    "reset:legacy-perks": "ts-node -r tsconfig-paths/register scripts/reset-legacy-perks-memberships.ts",
    "diagnose:perks-member": "ts-node -r tsconfig-paths/register scripts/diagnose-perks-member.ts"
  },
